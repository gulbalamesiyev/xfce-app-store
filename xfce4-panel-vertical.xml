<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
  </property>
  <property name="panel-1" type="empty">
    <property name="position" type="string" value="p=12;x=0;y=0"/> <!-- Fixed Right Side Middle, Vertically Center -->
    <property name="length" type="uint" value="1"/> <!-- Calculated automatically based on items to keep compact -->
    <property name="length-adjust" type="bool" value="true"/> <!-- TRUE makes the glass expand fluidly based on app list! -->
    <property name="position-locked" type="bool" value="true"/>
    <property name="mode" type="uint" value="1"/> <!-- 1 means vertical layout mode (Şaquli) -->
    <property name="size" type="uint" value="64"/> <!-- 64px width panel to comfortably fit huge 48px icons + touch pad -->
    <property name="plugin-ids" type="array">
      <value type="int" value="1"/> <!-- Applications Menu / App Store shortcut -->
      <value type="int" value="2"/> <!-- Separator with expand false -->
      <value type="int" value="3"/> <!-- Dynamic Tasklist (Running icons) -->
      <value type="int" value="4"/> <!-- Systray (Battery, Network indicators) -->
      <value type="int" value="5"/> <!-- Digital Clock -->
    </property>
  </property>
  <property name="plugins" type="empty">
    <property name="plugin-1" type="string" value="applicationsmenu"/>
    <property name="plugin-2" type="string" value="separator">
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-3" type="string" value="tasklist">
      <property name="flat-buttons" type="bool" value="true"/>
      <property name="show-labels" type="bool" value="false"/> <!-- Hide text labels to keep it icon-only compact like iOS/Android -->
      <property name="grouping" type="uint" value="1"/> <!-- Auto-group windows from same app -->
      <property name="include-all-monitors" type="bool" value="true"/>
      <property name="sort-order" type="uint" value="0"/>
    </property>
    <property name="plugin-4" type="string" value="systray">
      <property name="square-icons" type="bool" value="true"/>
      <property name="icon-size" type="uint" value="22"/>
    </property>
    <property name="plugin-5" type="string" value="clock">
      <property name="digital-layout" type="uint" value="3"/>
      <property name="digital-format" type="string" value="%H:%M"/>
    </property>
  </property>
</channel>
